# Copy to .env.local for local dev, and add the same keys in Vercel.

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Stripe (Developers -> API keys). Connect must be enabled on the account.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
# Webhook signing secrets: one endpoint for your account's events,
# one "Connected accounts" endpoint for account.updated. Same URL for both.
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxx

# Resend (resend.com -> API keys). EMAIL_FROM must use a verified domain.
RESEND_API_KEY=re_xxx
EMAIL_FROM="Pizza Service <pizza@yourdomain.com>"

# Shared secret the scheduler sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=make-a-long-random-string
